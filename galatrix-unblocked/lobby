      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body, #root { width: 100%; height: 100%; overflow: hidden; }
      body { background: #000; color: #fff; font-family: system-ui, sans-serif; }
      canvas { display: block; }
      /* Touch. A canvas at the default touch-action does NOT own its gestures: the browser decides a drag
         is a scroll or a pinch, takes the pointer stream and fires pointercancel, so a thumb plants a
         stick and loses it — on a real phone only. The --safe-* variables are what DeviceInfo.safeArea is
         read from, and env() needs viewport-fit=cover in the meta above to resolve to anything.
         MUST MATCH src/engine/touchPage.ts — scripts/touchPage.test.mts fails if it drifts. */
      :root{--safe-left:env(safe-area-inset-left,0px);--safe-right:env(safe-area-inset-right,0px);--safe-top:env(safe-area-inset-top,0px);--safe-bottom:env(safe-area-inset-bottom,0px)}
      html,body{overscroll-behavior:none}
      canvas{touch-action:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}
      .gx-ui-overlay{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}
      .gx-ui-overlay input,.gx-ui-overlay textarea{-webkit-user-select:text;user-select:text}
      /* A dropdown's OPEN list is drawn by the OS, not by us, so it ignores the dark background and light
         text the <select> itself carries — on Windows it came up light grey behind our pale text and was
         barely readable. `color-scheme` is the one thing that reaches that native popup; scoped to the
         controls that need it so it cannot repaint scrollbars everywhere. The explicit option colours are
         the fallback for browsers that draw the list themselves. */
      select, option, optgroup { color-scheme: dark; }
      option, optgroup { background-color: #1e1e2e; color: #cdd6f4; }
    </style>
    <script type="module">
      // Render flavor pick (docs/RENDER-BACKEND-PLAN.md). WebGL 2 by default; WebGPU when asked for.
      //
      // Precedence, highest first:
      //   ?renderer=              support/bisect override
      //   session pin             a game already told us its content cannot render on node (see below)
      //   galatrix_gfx_renderer   the player's Settings ▸ Graphics choice (client/src/ui/playerPrefs.ts)
      //   default                 webgl2
      //
      // The default MUST match resolveRenderDriver's `auto` branch (shared/src/renderDriver.ts): this
      // picks the chunk graph before any of that code exists, so if the two disagreed every session
      // would boot one flavor and be sent straight back for the other. WebGL 2 measured faster on real
      // maps (upstream #30560), so the unchosen default is the quicker one; asking for WebGPU by
      // preference or by URL still gets it.
      //
      // THE PIN survives for the other direction: a game whose content cannot render on node writes
      // 'webgl2' here and reloads. Session-scoped, so it never becomes a sticky downgrade.
      let want = 'webgl2', pinned = null
      try {
        pinned = sessionStorage.getItem('galatrix_gfx_flavor_pin')
        want = new URLSearchParams(location.search).get('renderer')
          || pinned
          || localStorage.getItem('galatrix_gfx_renderer')
          || 'webgl2'
      } catch (e) {}
      let webgpu = false
      if (want === 'webgpu') {
        // navigator.gpu EXISTING is not availability: a blocklisted GPU exposes the API and then hands
        // back a null adapter, and loading the node graph on one of those is a black screen rather than
        // a fallback. Only paid by someone who ASKED for WebGPU now that WebGL 2 is the default, so the
        // default boot path no longer waits on requestAdapter at all.
        try { webgpu = !!(navigator.gpu && await navigator.gpu.requestAdapter()) } catch (e) { webgpu = false }
      }
      import(webgpu ? "/assets/index-DMJZLj4Z.js" : "/assets/index-DJfrfTox.js")
    </script>
